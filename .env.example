IRON_ARCANA_GENERATION_SIZE=384
IRON_ARCANA_GENERATION_STEPS=4

IRON_ARCANA_SPRITE_SIZE=96
IRON_ARCANA_PALETTE_SIZE=28
IRON_ARCANA_PREVIEW_SCALE=3

IRON_ARCANA_MOTION_ANALYSIS_SIZE=128
IRON_ARCANA_RETRY_WEAK_POSE=true
IRON_ARCANA_MOTION_MAX_ATTEMPTS=2

IRON_ARCANA_MOTION_MIN_MEAN_DIFFERENCE=4.5
IRON_ARCANA_MOTION_MIN_CHANGED_FRACTION=0.055
IRON_ARCANA_MOTION_MIN_SILHOUETTE_CHANGED_FRACTION=0.018

IRON_ARCANA_CONTACT_MIN_MEAN_DIFFERENCE=5.5
IRON_ARCANA_CONTACT_MIN_CHANGED_FRACTION=0.065
IRON_ARCANA_CONTACT_MIN_SILHOUETTE_CHANGED_FRACTION=0.025

IRON_ARCANA_HIT_VARIANTS=2
IRON_ARCANA_HIT_FRAMES=3
IRON_ARCANA_DEATH_FRAMES=5
IRON_ARCANA_CORPSE_VARIANTS=3

IRON_ARCANA_POLL_INTERVAL_MS=750
IRON_ARCANA_GENERATION_COOLDOWN_MS=150
IRON_ARCANA_CHROMA_SPILL_PASSES=1

IRON_ARCANA_APPEARANCE_LOCK=true
IRON_ARCANA_APPEARANCE_STRENGTH=1

# Master generation retry count. The pipeline retries the full master stage this many times before failing.
IRON_ARCANA_MASTER_MAX_ATTEMPTS=3

# Back-master generation reference-attempt count.
# The first N attempts (this value) use the front-master as reference; then retries continue without reference.
IRON_ARCANA_MASTER_BACK_REFERENCE_ATTEMPTS=2

# QA thresholds used by back-master perspective validation.
# A value below this mean difference is treated as "too similar".
IRON_ARCANA_MASTER_PERSPECTIVE_MIN_MEAN=9

# QA thresholds used by back-master perspective validation.
# Minimum changed pixel ratio between front/back master images.
IRON_ARCANA_MASTER_PERSPECTIVE_MIN_CHANGED=0.12

# QA thresholds used by back-master perspective validation.
# Minimum changed silhouette ratio (outline union area) between front/back master images.
IRON_ARCANA_MASTER_PERSPECTIVE_MIN_SILHOUETTE=0.035

# Master ear quality checks.
IRON_ARCANA_MASTER_EAR_QA=true
IRON_ARCANA_MASTER_MAX_EAR_COMPONENTS=2
IRON_ARCANA_MASTER_MIN_EAR_COMPONENT_PIXELS=45

# Quality floor for walk passing motion frames.
IRON_ARCANA_WALK_PASSING_MIN_MEAN=9
IRON_ARCANA_WALK_PASSING_MIN_CHANGED=0.1
IRON_ARCANA_WALK_PASSING_MIN_SILHOUETTE=0.04

# Motion retry behavior.
IRON_ARCANA_MOTION_MAX_ATTEMPTS=2
IRON_ARCANA_RETRY_WEAK_POSE=true
